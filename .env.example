# PostgreSQL connection used by Prisma. Use separate databases for local
# development, Vercel Preview, and Vercel Production; never share them.
# Copy this file to .env (ignored by git) and replace the dummy value.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/dairy?schema=public"

# This is the only environment variable the app needs. Public pages and auth
# actions work on standard Next.js production deployments without extra flags.
# Apply committed migrations to each database as a controlled step with
# `npm run db:deploy`; builds and deployments do not run migrations.

# No password or session secret belongs here. Local accounts are registered in
# the app and stored in PostgreSQL. Passwords are stored only as salted scrypt
# encodings, and browser session tokens only as SHA-256 digests.
